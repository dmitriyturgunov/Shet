<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="12dp">

    <!-- Верхняя панель -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Меню"
            android:textColor="@color/text_dim"
            android:textSize="14sp"
            android:background="?android:attr/selectableItemBackground"
            android:paddingHorizontal="8dp"
            android:minWidth="0dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/levelLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сложение до 10"
            android:textColor="@color/green_light"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_gravity="center_vertical"/>
    </LinearLayout>

    <TextView
        android:id="@+id/statsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Решено: 0 · Среднее: — · Лучшее: —"
        android:textColor="@color/green_light"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="4dp"/>

    <!-- Основное поле -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/letterText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="?"
            android:textColor="@color/text"
            android:textSize="72sp"
            android:textStyle="bold"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Индикатор микрофона -->
    <TextView
        android:id="@+id/micIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎤 Микрофон выключен"
        android:textColor="@color/text_dim2"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginBottom="4dp"/>

    <!-- Статус -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Нажмите СТАРТ"
        android:textColor="@color/text_dim"
        android:textSize="15sp"
        android:gravity="center"
        android:minHeight="40dp"
        android:layout_marginBottom="6dp"/>

    <!-- Клавиатура 5x2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/num1"
                style="@style/NumBtn"
                android:layout_weight="1"
                android:text="1"/>

            <Button
                android:id="@+id/num2"
                style="@style/NumBtn"
                android:layout_weight="1"
                android:text="2"/>

            <Button
                android:id="@+id/num3"
                style="@style/NumBtn"
                android:layout_weight="1"
                android:text="3"/>

            <Button
                android:id="@+id/num4"
                style="@style/NumBtn"
                android:layout_weight="1"
                android:text="4"/>

            <Button
                android:id="@+id/num5"
                style="@style/NumBtn"
                android:layout_weight="1"
                android:text="5"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/num6"
                style="@style/NumBtn"
                android:layout_weight="1"
                android:text="6"/>

            <Button
                android:id="@+id/num7"
                style="@style/NumBtn"
                android:layout_weight="1"
                android:text="7"/>

            <Button
                android:id="@+id/num8"
                style="@style/NumBtn"
                android:layout_weight="1"
                android:text="8"/>

            <Button
                android:id="@+id/num9"
                style="@style/NumBtn"
                android:layout_weight="1"
                android:text="9"/>

            <Button
                android:id="@+id/num0"
                style="@style/NumBtn"
                android:layout_weight="1"
                android:text="0"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/delBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⌫"
                android:textColor="#FCA5A5"
                android:textSize="20sp"
                android:background="@color/red_dark"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/checkBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:text="✓"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:background="@color/green"/>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/skipBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Пропустить →"
        android:textColor="@color/text_dim2"
        android:textSize="14sp"
        android:background="?android:attr/selectableItemBackground"
        android:layout_marginTop="4dp"
        android:minHeight="0dp"
        android:paddingVertical="8dp"/>

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="СТАРТ"
        android:textColor="@color/text"
        android:textSize="17sp"
        android:textStyle="bold"
        android:background="@color/blue"
        android:layout_marginTop="4dp"/>

</LinearLayout>
